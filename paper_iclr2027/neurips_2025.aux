\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Component-wise ablation under both alignment conventions.} Top block: identity-alignment form ($W{=}I$, used throughout the main text). Bottom block: Procrustes-optimal $W{=}W_N$ form. Same per-cell Spearman protocol throughout. Within each block, rows add bound components cumulatively (shape $\to +$ scale $\to +$ head); larger $|r_s|$ = better variant ranking; bold = best in column \emph  {within its block}. The $W{=}W_N$ block ranks modestly better on the full bound, as expected since $W_N$ minimizes the alignment residual; the main text adopts the identity alignment $W{=}I$ for autograd compatibility and for the head-term simplification $H_T = H_P$ that holds in our frozen-\texttt  {lm\_head} regimes.}}{10}{table.3}\protected@file@percent }
\newlabel{tab:baseline_combined}{{3}{10}{\textbf {Component-wise ablation under both alignment conventions.} Top block: identity-alignment form ($W{=}I$, used throughout the main text). Bottom block: Procrustes-optimal $W{=}W_N$ form. Same per-cell Spearman protocol throughout. Within each block, rows add bound components cumulatively (shape $\to +$ scale $\to +$ head); larger $|r_s|$ = better variant ranking; bold = best in column \emph {within its block}. The $W{=}W_N$ block ranks modestly better on the full bound, as expected since $W_N$ minimizes the alignment residual; the main text adopts the identity alignment $W{=}I$ for autograd compatibility and for the head-term simplification $H_T = H_P$ that holds in our frozen-\texttt {lm\_head} regimes}{table.3}{}}
