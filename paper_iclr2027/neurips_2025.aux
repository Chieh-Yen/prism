\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The PRISM bound $\mathcal  {B}$ tracks the empirical risk gap across two model families and five benchmarks.} Each subplot scatters the PRISM bound $\mathcal  {B}$ (x-axis, log) against the empirical cross-entropy risk gap $|\Delta \mathcal  {R}|$ (y-axis, log). Each point is one quantization variant; colors denote PTQ family (GGUF / GPTQ / BitsAndBytes). Rows: Llama-3.1-8B, Qwen3-8B. Columns: ARC, MMLU, SQuAD, TriviaQA, GSM8K. Per-subplot Spearman $r_s$ is annotated in each panel (mean $|r_s|{\approx }0.82$ across the 2{$\times $}5 grid; per-component breakdown in Sec.~\ref {subsec:ablation}); the red dashed $y{=}x$ line marks bound tightness, and the \textcolor {green!50!black}{green shaded region below it} is the safe zone where the bound provably holds. Replication on Ministral-3-8B and DeepSeek-R1-Distill-Llama-8B: Fig.~\ref {fig:quant_grid_bound_extra} (Appendix~\ref {app:quant_tables}).}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:quant_grid_bound}{{2}{7}{\textbf {The PRISM bound $\mathcal {B}$ tracks the empirical risk gap across two model families and five benchmarks.} Each subplot scatters the PRISM bound $\mathcal {B}$ (x-axis, log) against the empirical cross-entropy risk gap $|\Delta \mathcal {R}|$ (y-axis, log). Each point is one quantization variant; colors denote PTQ family (GGUF / GPTQ / BitsAndBytes). Rows: Llama-3.1-8B, Qwen3-8B. Columns: ARC, MMLU, SQuAD, TriviaQA, GSM8K. Per-subplot Spearman $r_s$ is annotated in each panel (mean $|r_s|{\approx }0.82$ across the 2{$\times $}5 grid; per-component breakdown in Sec.~\ref {subsec:ablation}); the red dashed $y{=}x$ line marks bound tightness, and the \textcolor {green!50!black}{green shaded region below it} is the safe zone where the bound provably holds. Replication on Ministral-3-8B and DeepSeek-R1-Distill-Llama-8B: Fig.~\ref {fig:quant_grid_bound_extra} (Appendix~\ref {app:quant_tables})}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Geometric decomposition for \textbf  {Llama-3.1-8B} under identity alignment ($W{=}I$) --- main task group. Each benchmark section reports Spearman's $r_s(\delta ,\,|\Delta \mathcal  {R}|)$ across all quantization variants.}}{7}{table.1}\protected@file@percent }
\newlabel{tab:llama_decomposition_main}{{1}{7}{Geometric decomposition for \textbf {Llama-3.1-8B} under identity alignment ($W{=}I$) --- main task group. Each benchmark section reports Spearman's $r_s(\delta ,\,|\Delta \mathcal {R}|)$ across all quantization variants}{table.1}{}}
