\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {PRISM decomposition of the risk gap.} The cross-entropy risk gap $|\mathcal  {R}_T{-}\mathcal  {R}_P|$ between target $T$ and proxy $P$ is bounded by a feature alignment error $\delta $ and a head discrepancy $\gamma $ (Thm.~\ref {thm:unified_bound}). Under Procrustes alignment $W^{*}{=}\arg \min _{W\in \mathcal  {O}(d)}\|Z_T{-}Z_PW\|_F$, $\delta $ decomposes exactly into \emph  {scale mismatch} $(\Delta \rho )^{2}{=}(\rho _T{-}\rho _P)^{2}$ and \emph  {shape mismatch} $2\rho _T\rho _P(1{-}\Omega )$ (Prop.~\ref {prop:exact_decomposition}); $\gamma $ measures $\Delta H{=}W^{*}H_T{-}H_P$ re-weighted by the proxy covariance $\Sigma _P$, vanishing when $H_T{=}H_P$ (frozen-head LoRA). Each axis localizes a distinct empirical regime: shape distortion at low-bit PTQ, output-embedding head divergence at GGUF Q6/Q8 tiers that quantize the \texttt  {lm\_head} (Qwen3-Base Q6\_K on MMLU in Table~\ref {tab:qwen_decomposition_all}: $\delta {=}0.75$ vs.\ $\gamma {=}60.16$; absent under BnB/GPTQ where $\gamma {\equiv }0$), and scale-axis separability under LoRA forgetting via the BBQ-vs-TruthfulQA drift contrast (Sec.~\ref {subsec:forget_exp}).}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:prism_concept}{{1}{3}{\textbf {PRISM decomposition of the risk gap.} The cross-entropy risk gap $|\mathcal {R}_T{-}\mathcal {R}_P|$ between target $T$ and proxy $P$ is bounded by a feature alignment error $\delta $ and a head discrepancy $\gamma $ (Thm.~\ref {thm:unified_bound}). Under Procrustes alignment $W^{*}{=}\arg \min _{W\in \mathcal {O}(d)}\|Z_T{-}Z_PW\|_F$, $\delta $ decomposes exactly into \emph {scale mismatch} $(\Delta \rho )^{2}{=}(\rho _T{-}\rho _P)^{2}$ and \emph {shape mismatch} $2\rho _T\rho _P(1{-}\Omega )$ (Prop.~\ref {prop:exact_decomposition}); $\gamma $ measures $\Delta H{=}W^{*}H_T{-}H_P$ re-weighted by the proxy covariance $\Sigma _P$, vanishing when $H_T{=}H_P$ (frozen-head LoRA). Each axis localizes a distinct empirical regime: shape distortion at low-bit PTQ, output-embedding head divergence at GGUF Q6/Q8 tiers that quantize the \texttt {lm\_head} (Qwen3-Base Q6\_K on MMLU in Table~\ref {tab:qwen_decomposition_all}: $\delta {=}0.75$ vs.\ $\gamma {=}60.16$; absent under BnB/GPTQ where $\gamma {\equiv }0$), and scale-axis separability under LoRA forgetting via the BBQ-vs-TruthfulQA drift contrast (Sec.~\ref {subsec:forget_exp})}{figure.1}{}}
