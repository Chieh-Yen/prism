\newlabel{app:qwen_shape_reg}{{G.2}{36}{Shape Regularization: Qwen3-8B Replication}{subsection.G.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {PRISM-guided shape regularization on Qwen3-8B (replication of Fig.~\ref {fig:shape_reg_combined_llama}).} LoRA fine-tuning on TruthfulQA (top row) and BBQ (bottom row) with the auxiliary penalty $\lambda (1-\Omega (Z_0^{\mathrm  {ref}}, Z_t^{\mathrm  {ref}}))$ at $\lambda \in \{0.0, 0.1, 0.5\}$ and analysis step $300$. The uniform downstream-forgetting reduction and the monotone trade-off between target-task fit and downstream damage seen on Llama hold on Qwen3-8B as well, confirming that the shape regularizer of Sec.~\ref {subsec:shape_reg} is not family-specific.}}{36}{figure.8}\protected@file@percent }
\newlabel{fig:shape_reg_combined_qwen}{{8}{36}{\textbf {PRISM-guided shape regularization on Qwen3-8B (replication of Fig.~\ref {fig:shape_reg_combined_llama}).} LoRA fine-tuning on TruthfulQA (top row) and BBQ (bottom row) with the auxiliary penalty $\lambda (1-\Omega (Z_0^{\mathrm {ref}}, Z_t^{\mathrm {ref}}))$ at $\lambda \in \{0.0, 0.1, 0.5\}$ and analysis step $300$. The uniform downstream-forgetting reduction and the monotone trade-off between target-task fit and downstream damage seen on Llama hold on Qwen3-8B as well, confirming that the shape regularizer of Sec.~\ref {subsec:shape_reg} is not family-specific}{figure.8}{}}
