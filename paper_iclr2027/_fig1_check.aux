\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {PRISM decomposition of the risk gap.} The cross-entropy risk gap $|\mathcal  {R}_T{-}\mathcal  {R}_P|$ between target $T$ and proxy $P$ is bounded by a feature alignment error $\delta $ and a head discrepancy $\gamma $ (Thm.~??). Under Procrustes alignment $W^{*}{=}\arg \min _{W\in \mathcal  {O}(d)}\|Z_T{-}Z_PW\|_F$, $\delta $ decomposes exactly into \emph  {scale mismatch} $(\Delta \rho )^{2}{=}(\rho _T{-}\rho _P)^{2}$ and \emph  {shape mismatch} $2\rho _T\rho _P(1{-}\Omega )$ (Prop.~??); $\gamma $ measures $\Delta H{=}W^{*}H_T{-}H_P$ re-weighted by the proxy covariance $\Sigma _P$, vanishing when $H_T{=}H_P$ (frozen-head LoRA).}}{1}{}\protected@file@percent }
\newlabel{fig:prism_concept}{{1}{1}{}{figure.1}{}}
